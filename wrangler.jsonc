// Publicação na Cloudflare como site estático (ADR-0002). Sem código de Worker: só os
// arquivos de dist/, que não contam no limite gratuito de requisições.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lojinha-da-lua",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "observability": { "enabled": false },
}
