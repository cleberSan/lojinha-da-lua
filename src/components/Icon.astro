---
import { whatsappPaths } from "./icon-paths";

/** Ícones decorativos desenhados para o site (sem marca registrada de terceiros). */
interface Props {
  name: "whatsapp" | "instagram" | "arrow-right";
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "whatsapp" && (
    <>
      <path d={whatsappPaths.balloon} />
      <path fill="currentColor" stroke="none" d={whatsappPaths.handset} />
    </>
  )}
  {name === "instagram" && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </>
  )}
  {name === "arrow-right" && <path d="M5 12h14M13 6l6 6-6 6" />}
</svg>
