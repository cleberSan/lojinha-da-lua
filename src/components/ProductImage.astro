---
import type { ImageMetadata } from "astro";
import { Image, Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  kind: "foto" | "ilustracao";
  sizes: string;
  loading?: "eager" | "lazy";
  showCaption?: boolean;
}

const { src, alt, kind, sizes, loading = "lazy", showCaption = false } = Astro.props;
// Ilustrações em SVG vão como estão; fotos viram AVIF/WebP em várias larguras no build.
// As fotos têm 1200 px: o cartão no celular e a página do produto em tela 2x pedem 900 ou mais.
const isVector = src.format === "svg";
const widths = [300, 450, 600, 900, 1200].filter((width) => width <= src.width);
---

<figure class="product-image" data-kind={kind}>
  {isVector ? (
    <Image src={src} alt={alt} loading={loading} decoding="async" />
  ) : (
    <Picture
      src={src}
      alt={alt}
      formats={["avif"]}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      loading={loading}
      decoding="async"
    />
  )}
  {kind === "ilustracao" && <span class="badge">Ilustração</span>}
  {showCaption && kind === "ilustracao" && (
    <figcaption class="muted">Ilustração do modelo: não é foto do produto.</figcaption>
  )}
</figure>

<style>
  .product-image {
    position: relative;
    margin: 0;
  }

  .product-image :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  .badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.15em 0.7em;
    border-radius: var(--radius-pill);
    background: rgb(4 8 36 / 0.8);
    color: var(--text);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }
</style>
